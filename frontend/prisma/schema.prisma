datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
model Hostels {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(255)
}
model CompetitionPlayer {
  uid String @id @db.VarChar(128)
  name String @db.VarChar(255)
  hostel_id Int?
  best_score Int?
  best_at DateTime? @db.Timestamptz(6)
  runs GameRun[]
  attempts SubmissionAttempt[]
  @@index([best_score(sort: Desc), best_at, uid], map: "CompetitionPlayer_ranking")
}
model GameRun {
  id String @id @db.Uuid
  uid String @db.VarChar(128)
  started_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  score Int?
  submitted_at DateTime? @db.Timestamptz(6)
  new_best Boolean?
  best_at_submission Int?
  player CompetitionPlayer @relation(fields: [uid], references: [uid], onDelete: NoAction, onUpdate: NoAction)
  @@index([uid, started_at], map: "GameRun_uid_started")
}
model SubmissionAttempt {
  id BigInt @id @default(autoincrement())
  uid String @db.VarChar(128)
  run_id String?
  score Int?
  outcome String
  attempted_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  player CompetitionPlayer @relation(fields: [uid], references: [uid], onDelete: NoAction, onUpdate: NoAction)
  @@index([uid, attempted_at], map: "SubmissionAttempt_uid_time")
}
