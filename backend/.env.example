DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=8000
FIREBASE_CREDENTIALS=/absolute/path/to/service-account.json
# PKCS#8 or PKCS#1 PEM, at least 2048 bits; keep secret and outside git.
PRIVATE_KEY=""
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Provisional, deliberately generous operational limits; adjust before launch.
RUN_TTL_SECONDS=86400
RUN_STARTS_PER_MINUTE=30
SUBMISSIONS_PER_MINUTE=60
